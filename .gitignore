# .gitignore for .NET
[Bb]in/
[Oo]bj/
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Database files
*.mdf
*.ldf
*.db
*.sqlite

# User-specific files
.idea/
.DS_Store

# Temporary files
*.tmp
*.temp
*.log

# Frontend dependencies and build output
node_modules/
dist/

# Release/build artifacts
*.exe
*.pdb
*.zip
CapLed_Release/
coverage-report/
TestResults/

# Local credentials / session files
token.txt
login.json
*.local.json

# Analytics generated outputs
analytics/exports/*
!analytics/exports/.gitkeep
analytics/exports_*/
